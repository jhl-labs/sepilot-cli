{
  "name": "sepilotd",
  "version": "1.0.4",
  "private": true,
  "type": "module",
  "license": "LicenseRef-Sepilot-Source-Available-1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jhl-labs/sepilot-cli.git"
  },
  "description": "sepilotd — local-first AI agent daemon and CLI (public source mirror of the daemon + CLI packages)",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --concurrency 20",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "build:binary": "pnpm --filter @sepilotd/bundle build:binary",
    "install:cli": "./install-cli.sh"
  },
  "devDependencies": {
    "turbo": "2.9.14",
    "typescript": "~5.7.0"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "patchedDependencies": {
      "image-size@1.2.1": "patches/image-size@1.2.1.patch",
      "ssh2@1.17.0": "patches/ssh2@1.17.0.patch"
    },
    "allowUnusedPatches": true,
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "node-pty"
    ],
    "overrides": {
      "@types/react": "^19.0.0",
      "@types/react-dom": "^19.0.0",
      "@xmldom/xmldom@0.8.12": "0.8.13",
      "brace-expansion@1.1.13": "1.1.18",
      "brace-expansion@2.0.3": "2.1.4",
      "brace-expansion@5.0.5": "5.0.9",
      "browserslist": "4.28.7",
      "dompurify": "3.4.13",
      "esbuild": "0.28.1",
      "fast-uri": "3.1.6",
      "form-data@4.0.5": "4.0.6",
      "ip-address@10.1.0": "10.3.1",
      "js-yaml@3.14.2": "3.15.1",
      "js-yaml@4.1.1": "4.3.1",
      "linkify-it@2.2.0": "5.0.2",
      "nanoid@3.3.11": "3.3.17",
      "next@15.5.18": "15.5.21",
      "postcss@8.4.31": "8.5.18",
      "postcss@8.4.49": "8.5.18",
      "request>form-data": "2.5.6",
      "@cypress/request>form-data": "2.5.6",
      "@types/request>form-data": "2.5.6",
      "protobufjs": "7.6.5",
      "shell-quote": "1.10.0",
      "@grpc/grpc-js": "^1.14.4",
      "hono": "4.13.5",
      "qs": "6.16.0",
      "@hono/node-server": "1.19.15",
      "find-my-way": "^9.7.0",
      "@codemirror/state": "6.7.1",
      "@codemirror/view": "6.43.6",
      "sharp@0.34.5": "0.35.3",
      "tmp@0.2.5": "0.2.7",
      "vite@7.3.2": "7.3.5",
      "ws@7.5.10": "7.5.13",
      "cli-truncate@4": "5.2.0"
    }
  }
}
