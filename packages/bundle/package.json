  "dependencies": {
    "@sepilotd/cli": "workspace:*",
    "@sepilotd/daemon": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "5.7.3",
    "yaml": "2.9.0"
  }
}
